generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  zohoId    String   @id
  name      String
  email     String?
  role      String   @default("OTHER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  zohoId          String   @id
  name            String
  prefix          String?
  status          String   @default("active")
  boardType       String   @default("scrum")
  description     String?
  ownerName       String?
  ownerZohoId     String?
  createdTime     String?
  backlogCount    Int?
  displayOrder    Int      @default(0)
  hidden          Boolean  @default(false)
  rawData         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  statusBreakdown String?
  statusGroups    String?
  statusMap       String?
  backlogZohoId   String?
}

model Sprint {
  zohoId          String   @id
  projectZohoId   String
  projectName     String
  name            String
  status          String   @default("active")
  startDate       String?
  endDate         String?
  totalTickets    Int      @default(0)
  statusBreakdown String?
  rawData         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Epic {
  zohoId        String   @id
  projectZohoId String
  name          String
  syncedAt      DateTime @default(now()) @updatedAt
}

model Issue {
  zohoId        String   @id
  sprintZohoId  String
  projectZohoId String
  itemNo        String
  title         String
  status        String
  statusGroup   String
  epicZohoId    String?
  creatorZohoId String?
  assigneeIds   String
  createdAt     String?
  endDate       String?
  syncedAt      DateTime @default(now()) @updatedAt
}

model Settings {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model BurndownSnapshot {
  sprintZohoId String
  date         String
  doneCount    Int
  totalCount   Int

  @@id([sprintZohoId, date])
}
