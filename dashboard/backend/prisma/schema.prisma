generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  zohoId    String   @id
  name      String
  email     String?
  role      String   @default("OTHER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  zohoId          String   @id
  name            String
  prefix          String?
  status          String   @default("active")
  boardType       String   @default("scrum")
  description     String?
  ownerName       String?
  ownerZohoId     String?
  createdTime     String?
  backlogCount    Int?
  displayOrder    Int      @default(0)
  hidden          Boolean  @default(false)
  rawData         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  statusBreakdown String?
  statusGroups    String?
  statusMap       String?
  backlogZohoId   String?
}

model Sprint {
  zohoId          String   @id
  projectZohoId   String
  projectName     String
  name            String
  status          String   @default("active")
  startDate       String?
  endDate         String?
  totalTickets    Int      @default(0)
  statusBreakdown String?
  rawData         String?
  hidden          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Epic {
  zohoId        String   @id
  projectZohoId String
  name          String
  syncedAt      DateTime @default(now()) @updatedAt
}

model Issue {
  zohoId        String   @id
  sprintZohoId  String
  projectZohoId String
  itemNo        String
  title         String
  status        String
  statusGroup   String
  epicZohoId    String?
  creatorZohoId String?
  assigneeIds   String
  createdAt     String?
  endDate       String?
  syncedAt      DateTime @default(now()) @updatedAt
}

model Settings {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model BurndownSnapshot {
  sprintZohoId String
  date         String
  doneCount    Int
  totalCount   Int

  @@id([sprintZohoId, date])
}

model Watchlist {
  id        String   @id @default(uuid())
  boardId   String                       // project zohoId — segregates by board
  issueId   String                       // issue zohoId
  userId    String                       // user zohoId — who owns this watchlist entry
  important Boolean  @default(false)     // marks ticket as important in issue listing
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([boardId, issueId, userId])
}

model Note {
  id               String     @id @default(uuid())
  userId           String                         // owner of the note
  title            String     @default("Untitled")
  content          String     @default("")        // full Markdown, no size limit
  issueIds         String                         // JSON string of issue zohoIds: '["zohoId1","zohoId2"]'
  taggedUserIds    String                         // JSON string of user zohoIds mentioned: '["zohoId1","zohoId2"]'
  state            String     @default("active")  // "active" or "closed"
  deadline         DateTime?                      // optional deadline for this note
  deadlineNotified Boolean    @default(false)     // whether 1-day-before notification was sent
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model Deadline {
  id        String   @id @default(uuid())
  boardId   String?                      // project zohoId, null = across all boards
  issueId   String?                      // issue zohoId, null = standalone reminder
  userId    String                       // user who set the deadline
  title     String
  dueDate   DateTime
  completed Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ActivityNotification {
  id        String   @id @default(uuid())
  userId    String
  type      String   @default("status_change")  // "status_change" | "deadline_reminder" | "deadline_day_of" | "deadline_overdue"
  issueId   String?                              // issue zohoId (null for note deadlines)
  boardId   String?                              // project zohoId (null for note deadlines)
  noteId    String?                              // note UUID if related to a note deadline
  oldStatus String   @default("")
  newStatus String   @default("")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}
