# Required — add these to your ~/.zshrc and run: source ~/.zshrc

# Zoho OAuth application credentials
ZOHO_CLIENT_ID=your_client_id_here
ZOHO_CLIENT_SECRET=your_client_secret_here
ZOHO_REFRESH_TOKEN=your_refresh_token_here

# Optional — discovered automatically on first run
# ZOHO_PORTAL_ID=your_portal_id_here

# Optional — sets the workspace name displayed in the dashboard
# ZOHO_WORKSPACE_NAME=your_workspace_name_here

# Optional — server port (default: 3001)
# PORT=3001
